{
  "name": "ornis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ornis — identificacao de cantos e fotos de aves com Pokedex offline",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "bench": "vitest run --config vitest.bench.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
